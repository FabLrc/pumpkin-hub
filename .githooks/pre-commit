#!/bin/sh
# Pre-commit checks:
# 1. cargo fmt on the api directory (Rust)
# 2. gitleaks — prevent accidental secret commits

set -e

# ── 1. Rust formatting ──────────────────────────────────────────────────────
cd "$(git rev-parse --show-toplevel)/api" || exit 1

if ! cargo fmt --all -- --check 2>/dev/null; then
  echo "--- cargo fmt: formatting issues detected, applying fixes ---"
  cargo fmt --all
  echo "--- Files have been reformatted. Please stage the changes and commit again. ---"
  exit 1
fi

# ── 2. Secret scanning ──────────────────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  cd "$(git rev-parse --show-toplevel)"
  gitleaks git --pre-commit --verbose 2>/dev/null || {
    echo "--- gitleaks: potential secrets detected. Commit aborted. ---"
    exit 1
  }
else
  echo "--- gitleaks not installed — skipping secret scan. Install with: brew install gitleaks ---"
fi
