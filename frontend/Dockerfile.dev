# DÉVELOPPEMENT UNIQUEMENT
FROM node:20-alpine

ENV NODE_ENV=development

WORKDIR /app

# Install dependencies at build time so the image is cached
COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 3000

# Run npm install at container start too, so that newly added dependencies
# (e.g. after git pull or package.json changes) are installed even if the
# anonymous node_modules volume persists between rebuilds.
CMD sh -c "npm install && npm run dev:docker"
